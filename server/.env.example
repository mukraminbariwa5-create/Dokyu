# Copy to .env and change the secrets. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dokyu:dokyu_dev_only@localhost:5432/dokyu
# Integration tests wipe this database before every test. Never point it at real data.
TEST_DATABASE_URL=postgresql://dokyu:dokyu_dev_only@localhost:5432/dokyu_test
# At least 32 random characters each, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-000000
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-0
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:8081
# Where links in emails point (the web app)
APP_URL=http://localhost:8081
# Sign-in / sign-up / password-reset attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20
# Optional: Super Admin password for pnpm db:seed (otherwise a random one is printed once)
SEED_ADMIN_PASSWORD=
