{
  "name": "@dokyu/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@dokyu/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.14",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.10.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0"
  }
}
