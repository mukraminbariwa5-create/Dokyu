{
  "expo": {
    "name": "Dokyu",
    "slug": "dokyu",
    "scheme": "dokyu",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "ph.dokyu.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-font", "expo-splash-screen", "expo-status-bar"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
