{
  "name": "dokyu",
  "private": true,
  "description": "Dokyu: Filipino government-documents guide and barangay request/queue system (Android + web).",
  "author": "Mukramin Bariwa Ansao",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:app": "pnpm --filter @dokyu/mobile-web start",
    "dev:web": "pnpm --filter @dokyu/mobile-web web",
    "dev:api": "pnpm --filter @dokyu/server dev",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @dokyu/server prisma:migrate",
    "db:seed": "pnpm --filter @dokyu/server seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "phone": "pnpm --filter @dokyu/mobile-web phone"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
